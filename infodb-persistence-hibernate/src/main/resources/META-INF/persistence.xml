<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="hibernate">
        <description>
            Persistence unit for the infodb HibernateDAO
        </description>

        <class>ovh.eukon05.infodb.persistence.hibernate.ArticleEntity</class>

        <properties>
            <!-- Database connection settings -->
            <property name="jakarta.persistence.jdbc.url" value="${infodb.hibernate.db.url}"/>
            <property name="jakarta.persistence.jdbc.user" value="${infodb.hibernate.db.user}"/>
            <property name="jakarta.persistence.jdbc.password" value="${infodb.hibernate.db.pass}"/>

            <!-- Automatically export the schema -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>

            <!-- Echo all executed SQL to console -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.highlight_sql" value="true"/>
        </properties>

    </persistence-unit>

</persistence>